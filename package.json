{
    "name": "tomo-care",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite\" \"node server/index.js\"",
        "dev:ui": "vite",
        "dev:api": "node server/index.js",
        "build": "vite build",
        "preview": "vite preview",
        "gmail:test": "node server/scripts/test-gmail.js",
        "gmail:inspect": "node server/scripts/inspect-gmail-message.js",
        "gmail:download": "node server/scripts/download-gmail-attachments.js",
        "eval:assistant": "node server/scripts/runAssistantEvals.js",
        "test:care-dates": "node --test server/lib/careDates.test.js",
        "test:actions": "node --test server/actions/*.test.js",
        "test:phase3b": "node --test server/actions/*.test.js server/lib/*.test.js server/assistant/*.test.js server/calendar/*.test.js server/dashboard/*.test.js",
        "test:phase3c-backend": "node --test server/actions/*.test.js server/messaging/*.test.js",
        "test:phase3c-ui": "node --test src/pages/Dashboard/*.test.js",
        "test:phase3c-orchestration": "node --test server/orchestration/*.test.js",
        "test:phase3d-voice": "node --test server/voice/*.test.js src/pages/Dashboard/voice*.test.js"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.110.7",
        "@tailwindcss/vite": "^4.2.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "googleapis": "^173.0.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.17.0",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "vite": "^8.0.4"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}