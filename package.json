        "test:phase3e0d": "node --test server/lib/verifiedWeight.test.js server/lib/verifiedWeightExtraction.test.js server/lib/verifiedWeightMigration.test.js server/lib/verifiedWeightRoute.test.js src/pages/VerifyDocs/recommendations.test.js src/pages/VerifyDocs/weightMaterializationFlow.test.js",
        "test:phase3e0e": "node --test server/lifecycle/librelaLifecycle.integration.test.js",
        "test:phase3e1a": "node --test server/lifecycle/librelaLifecycle.integration.test.js",
        "test:phase3e2": "node --test server/lifecycle/homeMedicationLifecycle.integration.test.js server/lifecycle/homeMedicationTransaction.contract.test.js",
        "test:phase3e3": "node --test server/reminders/reminderTiming.test.js server/attention/attentionService.test.js server/assistant/dateRanges.test.js server/assistant/queryPlanner.test.js server/assistant/conversationContext.test.js server/assistant/semanticUnderstanding.test.js server/assistant/openAiSemanticProvider.test.js server/assistant/assistantService.test.js server/assistant/answerComposer.test.js server/actions/listPendingCareActions.test.js src/pages/Dashboard/attentionNavigation.test.js src/pages/Dashboard/attentionNavigationUI.test.js",
        "test:phase3e4": "node --test server/profile/governedProfile.test.js server/profile/profileRepository.test.js server/dashboard/careSummary.test.js server/assistant/queryPlanner.test.js server/assistant/semanticUnderstanding.test.js server/assistant/openAiSemanticProvider.test.js server/assistant/assistantService.test.js server/assistant/answerComposer.test.js server/assistant/relationshipProfile.test.js server/assistant/boundedLanguage.test.js server/voice/spokenAnswer.test.js src/lib/petAge.test.js src/pages/Dashboard/attentionNavigation.test.js src/pages/Dashboard/attentionNavigationUI.test.js src/pages/Dashboard/conversationalHomeAccessibility.test.js",
        "test:phase3e5": "node --test server/verification/*.test.js src/pages/VerifyDocs/formatDisplayMoney.test.js src/pages/VerifyDocs/triageReviewState.test.js src/pages/VerifyDocs/recommendations.test.js server/lib/verifiedWeightExtraction.test.js",
        "test:phase3e6a": "node --test server/orchestration/specialistContract.test.js server/orchestration/tomoManager.test.js server/orchestration/verificationIntelligenceSpecialist.test.js server/orchestration/verificationIntelligenceHandoff.test.js server/verification/verificationManagerRouteBoundary.test.js",
        "test:phase3e6b": "node --test server/orchestration/careOperationsSpecialist.test.js server/orchestration/careOperationsHandoff.test.js server/orchestration/tomoManager.test.js server/assistant/assistantService.test.js server/assistant/conversationContext.test.js server/assistant/dateRanges.test.js server/assistant/homeMedicationAction.test.js server/assistant/queryPlanner.test.js server/assistant/semanticUnderstanding.test.js server/lifecycle/homeMedicationLifecycle.integration.test.js server/lifecycle/homeMedicationTransaction.contract.test.js src/pages/Dashboard/voiceAccessibility.test.js",
    "test:phase3e6c": "node --test src/lib/orchestrationTracePresentation.test.js src/components/OrchestrationTraceUI.test.js server/orchestration/tomoManager.test.js server/orchestration/verificationIntelligenceHandoff.test.js server/orchestration/careOperationsHandoff.test.js src/pages/Dashboard/voiceAccessibility.test.js src/pages/VerifyDocs/triageReviewState.test.js",
        "test:phase3e7a": "node --test server/gmail/gmailInbox.test.js server/gmail/documentProcessingFallback.test.js server/lib/vaccineEvidence.test.js server/lib/insuranceClaimReminder.test.js server/verification/vaccineEvidenceVerification.test.js server/verification/verificationReviewTools.test.js server/documents/vaccineEvidenceMaterialization.test.js server/documents/vaccineEvidenceMigration.contract.test.js server/assistant/vaccineEvidence.test.js src/pages/Dashboard/inboxRecoveryPresentation.test.js src/pages/VerifyDocs/vaccineEvidencePresentation.test.js src/pages/VerifyDocs/clinicCorrectionFlow.test.js src/pages/VerifyDocs/recommendations.test.js src/pages/VerifyDocs/triageReviewState.test.js src/pages/VerifyDocs/verificationRecoveryPresentation.test.js && PYTHONPATH=agent python3 -m unittest agent.tests.test_vaccine_evidence",
        "test:phase3e8": "node --test server/assistant/weightTrendPresentation.test.js server/assistant/answerComposer.test.js server/voice/spokenAnswer.test.js server/voice/voiceQuery.test.js src/pages/Dashboard/verifiedWeightTrendPresentation.test.js src/pages/Dashboard/verifiedWeightTrendChartUI.test.js src/pages/Dashboard/citationPresentation.test.js",
        "test:phase3f": "node --test server/actions/prepareLibrelaAppleMessagesHandoff.test.js server/actions/resolveLibrelaAppleMessagesHandoff.test.js server/messaging/appleMessagesHandoff*.test.js src/pages/Dashboard/appleMessagesHandoff.test.js src/pages/Dashboard/careActionRecovery.test.js src/pages/Dashboard/librelaAppleMessagesHandoffUI.test.js",
        "test:actions": "node --test server/actions/*.test.js",
        "test:phase3b": "node --test server/actions/*.test.js server/lib/*.test.js server/assistant/*.test.js server/calendar/*.test.js server/dashboard/*.test.js server/gmail/*.test.js",
        "test:phase3c-backend": "node --test server/actions/*.test.js server/messaging/*.test.js",
        "test:phase3c-ui": "node --test src/pages/Dashboard/*.test.js",
        "test:phase3c-orchestration": "node --test server/orchestration/*.test.js",
        "test:phase3d-avatar": "node --test server/avatar/*.test.js src/pages/Dashboard/runwayAvatarClient.test.js",
        "test:phase3d-voice": "node --test server/voice/*.test.js server/assistant/boundedLanguage.test.js server/assistant/conversationContext.test.js server/assistant/openAiSemanticProvider.test.js server/assistant/personalityLayer.test.js server/assistant/relationshipProfile.test.js server/assistant/semanticUnderstanding.test.js src/pages/Dashboard/voice*.test.js"
    },
    "dependencies": {
        "@livekit/agents": "^1.6.1",
        "@livekit/agents-plugin-runway": "^1.6.1",
        "@supabase/supabase-js": "^2.110.7",
        "@tailwindcss/vite": "^4.2.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "googleapis": "^173.0.0",
        "livekit-client": "^2.21.0",
        "livekit-server-sdk": "^2.17.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.17.0",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "vite": "^8.0.4"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
