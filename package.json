{
    "name": "tomo-care",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite\" \"node server/index.js\"",
        "dev:all": "concurrently --kill-others --names ui,api,avatar --prefix-colors cyan,green,magenta \"npm:dev:ui\" \"npm:dev:api\" \"npm:dev:avatar\"",
        "dev:ui": "vite",
        "dev:api": "node server/index.js",
        "dev:avatar": "node server/avatar/runwayAvatarAgent.js dev",
        "build": "vite build",
        "preview": "vite preview",
        "gmail:test": "node server/scripts/test-gmail.js",
        "gmail:inspect": "node server/scripts/inspect-gmail-message.js",
        "gmail:download": "node server/scripts/download-gmail-attachments.js",
        "eval:assistant": "node server/scripts/runAssistantEvals.js",
        "test:care-dates": "node --test server/lib/careDates.test.js",
        "test:phase3e0a": "node --test server/lib/librelaEvidence.test.js src/pages/VerifyDocs/recommendations.test.js",
        "test:phase3e0b": "node --test server/lib/librelaEvidence.test.js server/lib/librelaReconciliation.test.js server/lib/librelaReconciliationMigration.test.js server/lib/librelaReconciliationRoute.test.js src/pages/VerifyDocs/recommendations.test.js src/pages/VerifyDocs/librelaReconciliationFlow.test.js",
