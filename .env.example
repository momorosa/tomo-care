# Private-care configuration. See docs/Local_Setup_and_Inbox_Isolation.md.
TOMOCARE_RUNTIME_MODE=real
TOMO_PET_ID=your_private_care_pet_uuid
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Optional: agent/.venv is selected automatically when this is unset.
# PYTHON_BIN=/absolute/path/to/tomo-care/agent/.venv/bin/python

# IANA timezone used to resolve care dates such as "today" and "yesterday".
APP_TIME_ZONE=America/Los_Angeles
